arang" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeWidth=2;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="t_detail_penjualan" target="t_barang"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="fk_pembelian_pemasok" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeWidth=2;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="t_pembelian" target="t_pemasok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="fk_dbeli_pembelian | ON DELETE CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeWidth=2;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="t_detail_pembelian" target="t_pembelian"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="fk_dbeli_barang" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeWidth=2;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.7;" edge="1" parent="1" source="t_detail_pembelian" target="t_barang"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="title" value="ERD Fisik Kopma - basis data kopma_028 (MariaDB 10.4, InnoDB, utf8mb4_unicode_ci)" style="text;html=0;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="34" as="geometry"/></mxCell><mxCell id="legend" value="Keterangan: PK = kunci primer; AI = AUTO_INCREMENT; UQ = UNIQUE; FK = kunci tamu (-&gt; tabel tujuan); PII = kolom data pribadi (merah). NOT NULL / NULL, DEFAULT, CHECK, dan ENUM sesuai skrip DDL.&#xa;Garis: kaki gagak = banyak di sisi tabel anak; garis ganda = tepat satu di sisi tabel induk; lingkaran + garis = nol atau satu (id_anggota pada penjualan = pembeli umum).&#xa;ON DELETE: hanya detail_penjualan dan detail_pembelian memakai CASCADE; kunci tamu lain memakai bawaan (RESTRICT). Nilai turunan (subtotal, total, kembalian) tidak digambar sebagai kolom." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#888888;dashed=1;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1780" height="80" as="geometry"/></mxCell><mxCell id="owner" value="Imam Khoiri - 25430028" style="text;html=0;fontStyle=1;align=right;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="890" width="300" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>