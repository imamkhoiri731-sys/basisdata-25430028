th=2;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t_detail_tindakan" target="t_tindakan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="fk_dresep_resep (1 : 1..N)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERoneToMany;endFill=0;startFill=0;strokeWidth=2;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="t_detail_resep" target="t_resep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="fk_dresep_obat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeWidth=2;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t_detail_resep" target="t_obat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="fk_dbeliobat_obat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeWidth=2;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="t_detail_pembelian_obat" target="t_obat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="fk_dbeliobat_pembelian | ON DELETE CASCADE (1 : 1..N)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERoneToMany;endFill=0;startFill=0;strokeWidth=2;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t_detail_pembelian_obat" target="t_pembelian_obat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="fk_pembelian_pemasok" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;strokeWidth=2;fontSize=10;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="t_pembelian_obat" target="t_pemasok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="title" value="ERD Fisik Klinik IK Sehat - basis data klinik_028 (MariaDB 10.4, InnoDB, utf8mb4_unicode_ci)" style="text;html=0;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="36" as="geometry"/></mxCell><mxCell id="legend" value="Keterangan: PK = kunci primer; AI = AUTO_INCREMENT; UQ = UNIQUE; FK = kunci tamu (-&gt; tabel tujuan); UQ* = unik gabungan (id_pemasok, no_faktur_pembelian).&#xa;Merah = kolom data pribadi (PII); oranye = data kesehatan (akses terbatas, AB-09). NOT NULL / NULL, DEFAULT, CHECK, dan ENUM sesuai skrip p05_ddl_klinik_25430028.sql.&#xa;Garis: kaki gagak = banyak di sisi tabel anak; garis ganda = tepat satu di sisi tabel induk; lingkaran + garis = nol atau satu (resep dan pembayaran per kunjungan).&#xa;ON DELETE: hanya detail_pembelian_obat memakai CASCADE; kunci tamu lain memakai bawaan RESTRICT agar data kunjungan dan pembayaran tidak terhapus (AB-10).&#xa;Nilai turunan (total tindakan, total obat, total tagihan, denda_keterlambatan) tidak digambar sebagai kolom. Batas P + 2 = 4 baris per kunjungan dan per resep (AB-03) tidak dapat dijaga CHECK -&gt; Modul 14." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#888888;dashed=1;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="2580" height="100" as="geometry"/></mxCell><mxCell id="owner" value="Imam Khoiri - 25430028" style="text;html=0;fontStyle=1;align=right;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2320" y="1230" width="300" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>