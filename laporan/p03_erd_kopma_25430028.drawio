        <mxCell id="4I1RPNP-scDBQ0jlCbkW-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Latihan E2: relasi banyak-ke-banyak langsung (tanpa entitas asosiatif)&lt;/font&gt;&lt;/b&gt;" vertex="1">
