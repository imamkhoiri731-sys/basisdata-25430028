        <mxCell id="4I1RPNP-scDBQ0jlCbkW-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Penjelasan Relasi M:N Penjualan dan Barang:&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="280" x="30" y="535" as="geometry" />
        </mxCell>
        <mxCell id="4I1RPNP-scDBQ0jlCbkW-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;1. Data yang Hilang&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Data yang hilang adalah &lt;code&gt;qty_detail_penjualan&lt;/code&gt; (jumlah unit barang yang dibeli) dan &lt;code&gt;harga_satuan_detail_penjualan&lt;/code&gt; (harga jual per unit saat transaksi berlangsung)&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="75" width="385" x="10" y="565" as="geometry" />
        </mxCell>
        <mxCell id="4I1RPNP-scDBQ0jlCbkW-19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;2. Alasan Tidak Memiliki Tempat&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Kedua data tersebut merupakan informasi milik &lt;b&gt;pasangan nota dan barang&lt;/b&gt; (&lt;i&gt;nota ini membeli barang itu&lt;/i&gt;). Data tidak bisa ditaruh di entitas &lt;code&gt;penjualan&lt;/code&gt; karena satu nota berisi banyak jenis barang, dan tidak bisa ditaruh di entitas &lt;code&gt;barang&lt;/code&gt; karena satu barang dijual di banyak nota transaksi.&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="30" width="450" x="10" y="660" as="geometry" />
        </mxCell>
        <mxCell id="4I1RPNP-scDBQ0jlCbkW-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;&lt;b&gt;3. Akibat pada Aturan Bisnis (AB-04)&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Melanggar aturan &lt;b&gt;AB-04&lt;/b&gt; yang mewajibkan harga saat transaksi dicatat per baris item. Karena harga di entitas &lt;code&gt;barang&lt;/code&gt; bisa naik atau turun di kemudian hari, tanpa pencatatan harga transaksi historis, nilai total laporan keuangan transaksi lama akan berubah dan menjadi salah.&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="30" width="470" x="10" y="740" as="geometry" />
        </mxCell>
