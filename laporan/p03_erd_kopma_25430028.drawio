        <mxCell id="4I1RPNP-scDBQ0jlCbkW-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Imam Khoiri - 25430028" vertex="1">
